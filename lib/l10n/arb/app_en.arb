  "legalPoint5": "MUSA does not host or distribute music or protected content.",
  "@legalPoint5": {"description": "Public beta legal flow"},
  "legalPoint6": "There are no accounts and no ads. Your library, history and settings stay on your phone.",
  "@legalPoint6": {"description": "Public beta legal flow"},
